---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const base = import.meta.env.BASE_URL;

const regions = [
  {
    name: "Africa",
    intro: "Long-term supply to family-owned blenders and distributors.",
    countries: ["Egypt", "Sudan"],
    grades: "CTC BP1 · Dust grades",
    shipping: "Direct container · 12–18 days · Port Said, Alexandria, Port Sudan",
  },
  {
    name: "Middle East",
    intro: "The largest destination for our tea — supply contracts with packers, blenders and tea bag manufacturers.",
    countries: ["United Arab Emirates", "Saudi Arabia", "Iran", "Pakistan", "Afghanistan", "Iraq", "Oman"],
    grades: "CTC Black Tea · Orthodox tea",
    shipping: "Direct container · 8–14 days · Jebel Ali, Bandar Abbas, Karachi, Salalah",
  },
  {
    name: "Central Asia",
    intro: "A growing region for us with distributors in three countries.",
    countries: ["Kazakhstan", "Uzbekistan", "Oman"],
    grades: "Orthodox OR",
    shipping: "Reefer & dry container via Bandar Abbas or Karachi · 22–32 days",
  },
];
---
<Base
  title="Global Markets — Tea Exporter to Africa, Middle East & Central Asia"
  description="Kenyan tea exports to 10+ countries. Direct shipping to Egypt, Sudan, UAE, Saudi Arabia, Pakistan, Kazakhstan and more."
>
  <Header />

  <section class="relative bg-[#0d3329] text-[#f4ecdc] py-24 md:py-32 overflow-hidden">
  <img
  src={`${base}/images/hero-markets.jpg`}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover"
    onerror="this.style.display='none'"
  />
  <div class="absolute inset-0 bg-gradient-to-br from-[#0d3329]/90 via-[#0d3329]/70 to-[#0d3329]/40"></div>
  <div class="relative max-w-5xl mx-auto px-5 lg:px-8">
    <p class="text-[#b9a48a] uppercase tracking-[0.3em] text-xs mb-6">Global Markets</p>
    <h1 class="text-5xl md:text-7xl leading-[0.95]" style="font-family:'DM Serif Display',serif;font-weight:400;">
      Your Global Partner <span class="text-[#b9a48a]">in Tea Supply.</span>
    </h1>
  </div>
</section>

<section class="bg-[#f4ecdc] py-16">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-[#0d3329]/10 border border-[#0d3329]/10">
    {[
      {
        n: "Global Reach",
        l: "Connecting tea buyers and markets worldwide"
      },
      {
        n: "Quality First",
        l: "Carefully sourced tea to meet your specifications"
      },
      {
        n: "Reliable Supply",
        l: "Dependable procurement and export coordination"
      },
      {
        n: "Tailored Solutions",
        l: "Flexible grades and packaging for your business"
      },
    ].map((s) => (
      <div class="bg-[#f4ecdc] p-8 text-center">
        <p
          class="text-[#0d3329] text-2xl md:text-3xl"
          style="font-family:'DM Serif Display',serif;"
        >
          {s.n}
        </p>
        <p class="text-sm text-[#3d3d3d] mt-3 leading-relaxed">
          {s.l}
        </p>
      </div>
    ))}
  </div>
</section>


<section class="bg-white py-24">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="max-w-3xl mb-14">
      <p class="text-[#b9a48a] uppercase tracking-[0.25em] text-xs mb-4">
        Global Tea Supply
      </p>
      <h2
        class="text-4xl md:text-6xl text-[#0d3329] leading-tight"
        style="font-family:'DM Serif Display',serif;font-weight:400;"
      >
        Connecting tea buyers to quality Kenyan tea.
      </h2>
      <p class="mt-6 text-[#3d3d3d] leading-relaxed">
        We supply international importers, distributors, wholesalers,
        tea packers and manufacturers with tea sourced to meet their
        requirements. Wherever your business operates, we work with you
        to identify suitable grades, packaging and export solutions.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-[#0d3329]/10 border border-[#0d3329]/10">
      {[
        {
          number: "01",
          title: "International Buyers",
          desc: "Supporting importers, wholesalers, distributors and trading companies seeking a dependable Kenyan tea supplier."
        },
        {
          number: "02",
          title: "Flexible Tea Selection",
          desc: "CTC black tea, orthodox tea and a range of grades to suit different markets, applications and customer specifications."
        },
        {
          number: "03",
          title: "Export Solutions",
          desc: "Coordinated documentation, packaging and shipping arrangements tailored to individual orders and destination requirements."
        },
        {
          number: "04",
          title: "Bulk & Custom Packaging",
          desc: "Packaging options designed for bulk buyers, tea packers, manufacturers and private-label requirements."
        },
        {
          number: "05",
          title: "Quality & Consistency",
          desc: "A quality-focused sourcing approach to help customers achieve the grade, character and consistency they require."
        },
        {
          number: "06",
          title: "New Market Opportunities",
          desc: "We welcome enquiries from established and emerging markets and explore supply options based on your requirements."
        }
      ].map((item) => (
        <div class="bg-[#f4ecdc] p-7 md:p-9">
          <p
            class="text-[#b9a48a] text-2xl mb-5"
            style="font-family:'DM Serif Display',serif;"
          >
            {item.number}
          </p>
          <h3 class="text-[#0d3329] text-xl font-semibold mb-3">
            {item.title}
          </h3>
          <p class="text-[#3d3d3d] text-sm leading-relaxed">
            {item.desc}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-12 bg-[#0d3329] text-[#f4ecdc] p-8 md:p-12 flex flex-col md:flex-row md:items-center md:justify-between gap-8">
      <div class="max-w-2xl">
        <h3
          class="text-2xl md:text-3xl mb-3"
          style="font-family:'DM Serif Display',serif;font-weight:400;"
        >
          Let's discuss your tea requirements.
        </h3>
        <p class="text-[#f4ecdc]/80 leading-relaxed">
          Tell us your destination market, preferred grades, packaging
          and quantity. Our team will work with you to explore a suitable
          supply solution.
        </p>
      </div>
      <a
        href={`${base}/contact`}
        class="shrink-0 inline-flex items-center justify-center gap-2 px-7 py-4 bg-[#b9a48a] text-[#0d3329] font-semibold hover:bg-[#d4b896] transition-colors"
      >
        Discuss Your Requirements →
      </a>
    </div>
  </div>
</section>

<section class="bg-[#0d3329] text-[#f4ecdc] py-24">
  <div class="max-w-4xl mx-auto px-5 lg:px-8 text-center">
    <p class="text-[#b9a48a] uppercase tracking-[0.25em] text-xs mb-5">
      Your Global Tea Partner
    </p>

    <h2
      class="text-4xl md:text-6xl leading-tight"
      style="font-family:'DM Serif Display',serif;font-weight:400;"
    >
      Let's Bring Quality Kenyan Tea to Your Market.
    </h2>

    <p class="mt-6 text-[#f4ecdc]/80 leading-relaxed max-w-2xl mx-auto">
      Whether you are an importer, distributor, wholesaler, tea packer
      or manufacturer, we welcome enquiries from markets worldwide.
      Share your requirements with us, and let's explore the right tea
      grades, packaging and supply solutions for your business.
    </p>

    <a
      href={`${base}/contact`}
      class="mt-8 inline-flex items-center gap-2 px-7 py-4 bg-[#b9a48a] text-[#0d3329] font-semibold hover:bg-[#d4b896] transition-colors"
    >
      Discuss Your Requirements
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

  <Footer />
</Base>