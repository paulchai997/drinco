---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import KleapForm from "@/components/KleapForm";

const base = import.meta.env.BASE_URL;

const offices = [
  { city: "Mombasa (Head Office)", address: "Olemonana House 1st Floor, Moi Avenue", hours: "Mon–Fri · 08:00–17:00 EAT", phone: "+254 72 884 1558" },
];
---
<Base
  title="Contact — Drinco International"
  description="Contact our Mombasa office for tea export inquiries. Email trading@drincointernational.com or call +254 72 884 1558."
  schema={[
    {
      "@type": "LocalBusiness",
      name: "Drinco International Limited",
      telephone: "+254 72 884 1558",
      email: "trading@drincointernational.com",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Olemonana House 1st Floor, Moi Avenue",
        addressLocality: "Mombasa",
        addressRegion: "Mombasa County",
        postalCode: "356 80100",
        addressCountry: "KE",
      },
      geo: { "@type": "GeoCoordinates", latitude: -4.0435, longitude: 39.6682 },
      openingHours: "Mo–Fr 08:00–17:00",
      url: "https://maps.google.com/?q=Moi+Avenue+Mombasa",
    },
  ]}
>
  <Header />

  <section class="relative bg-[#0d3329] text-[#f4ecdc] py-24 md:py-32 overflow-hidden">
  <img
    src={`${base}images/hero-contact.webp`}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover"
    onerror="this.style.display='none'"
  />
  <div class="absolute inset-0 bg-gradient-to-br from-[#0d3329]/90 via-[#0d3329]/70 to-[#0d3329]/40"></div>
  <div class="relative max-w-5xl mx-auto px-5 lg:px-8">
    <p class="text-[#b9a48a] uppercase tracking-[0.3em] text-xs mb-6">Contact</p>
    <h1 class="text-5xl md:text-7xl leading-[0.95]" style="font-family:'DM Serif Display',serif;font-weight:400;">
      Tell us what<br/><span class="text-[#b9a48a]">you need.</span>
    </h1>
    <p class="mt-8 text-lg text-[#f4ecdc]/85 max-w-2xl leading-relaxed">
      We answer every inquiry within one working day. For urgent shipments, call our desk directly.
    </p>
  </div>
</section>

  <section class="bg-[#f4ecdc] py-20">
    <div class="max-w-7xl mx-auto px-5 lg:px-8 grid lg:grid-cols-2 gap-14">
      <div>
        <KleapForm
          client:load
          formId="contact"
          title="Send an Inquiry"
          fields={[
            { name: "name", label: "Full Name", type: "text", required: true },
            { name: "company", label: "Company", type: "text" },
            { name: "email", label: "Email", type: "email", required: true },
            { name: "phone", label: "Phone / WhatsApp", type: "tel" },
            { name: "country", label: "Destination Country", type: "text", required: true },
            { name: "tea_grade", label: "Tea Grade of Interest", type: "text", placeholder: "e.g. CTC BP1, Orthodox OP" },
            { name: "quantity", label: "Estimated Quantity (kg)", type: "text" },
            { name: "incoterm", label: "Preferred Terms", type: "text", placeholder: "FOB / CIF / CFR" },
            { name: "message", label: "Tell us more about your requirement", type: "textarea", required: true },
          ]}
          submitText="Send Inquiry"
        />
      </div>

      <div>
        <div class="bg-white border border-[#0d3329]/10 p-8">
          <p class="text-[#0d3329] uppercase tracking-widest text-xs mb-4">Mombasa Office</p>
          <p class="text-[#0d3329] text-2xl mb-1" style="font-family:'DM Serif Display',serif;font-weight:400;">Olemonana House 1st Floor</p>
          <p class="text-[#3d3d3d]">Moi Avenue, Mombasa, Kenya</p>
          <div class="mt-6 space-y-3 text-[#3d3d3d]">
            <p class="flex items-start gap-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0d3329" stroke-width="2" class="mt-1"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <a href="mailto:trading@drincointernational.com" class="hover:text-[#0d3329] underline underline-offset-2">trading@drincointernational.com</a>
            </p>
            <p class="flex items-start gap-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0d3329" stroke-width="2" class="mt-1"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <a href="+254 72 884 1558" class="hover:text-[#0d3329] underline underline-offset-2">+254 72 884 1558</a>
            </p>
            <p class="flex items-start gap-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0d3329" stroke-width="2" class="mt-1"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Mon–Fri · 08:00–17:00 EAT
            </p>
          </div>
          <a href="https://maps.google.com/?q=Moi+Avenue+Mombasa" target="_blank" rel="noopener" class="mt-6 inline-flex items-center gap-2 text-[#0d3329] font-semibold border-b border-[#0d3329] pb-1">
            Open in Google Maps
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
          </a>
        </div>


        <!-- FOLLOW US -->
        <div class="mt-6 rounded-2xl border border-[#0d3329]/10 bg-white p-8">
          <h2 class="mb-4 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-[#0d3329]">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
            </svg>
            Follow Us
          </h2>

          <div class="flex flex-wrap gap-2.5">
            {/*<a
              href="https://www.facebook.com/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              title="Facebook"
              class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#e2e6d7] text-[#176534] transition hover:bg-[#d3ddc5] hover:-translate-y-0.5"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.7V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V10H7.3v3h2.8v8h3.4Z" />
                <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </a>

            <a
              href="https://www.instagram.com/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              title="Instagram"
              class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#e2e6d7] text-[#176534] transition hover:bg-[#d3ddc5] hover:-translate-y-0.5"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
            </a>

            <a
              href="https://x.com/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="X"
              title="X"
              class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#e2e6d7] text-[#176534] transition hover:bg-[#d3ddc5] hover:-translate-y-0.5"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-5-7.5L5.4 22H2.2l7.3-8.4L1.7 2h6.5l4.5 6.9L18.9 2Zm-1.1 18h1.7L7.2 3.9H5.4L17.8 20Z" />
              </svg>
            </a>

            <a
              href="https://www.pinterest.com/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Pinterest"
              title="Pinterest"
              class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#e2e6d7] text-[#176534] transition hover:bg-[#d3ddc5] hover:-translate-y-0.5"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 0 0-3.6 19.3c0-.8 0-1.8.2-2.7l1.3-5.4s-.3-.6-.3-1.5c0-1.4.8-2.5 1.9-2.5.9 0 1.3.7 1.3 1.5 0 .9-.6 2.3-.9 3.6-.3 1.1.5 2 1.6 2 1.9 0 3.4-2.5 3.4-5.4 0-2.2-1.5-3.9-4.2-3.9-3.1 0-5 2.3-5 4.8 0 .9.3 1.8.8 2.3.2.2.2.3.1.6l-.3 1.1c-.1.4-.3.5-.6.3-1.4-.6-2-2.2-2-4 0-3 2.5-6.6 7.4-6.6 4 0 6.6 2.9 6.6 6 0 4.1-2.3 7.2-5.8 7.2-1.2 0-2.3-.7-2.7-1.4l-.8 3.1c-.3 1.1-.9 2.1-1.4 2.9A10 10 0 1 0 12 2Z" />
              </svg>
            </a>*/}

            <a
              href="https://www.linkedin.com/company/drinco-international-limited/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              title="LinkedIn"
              class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#e2e6d7] text-[#176534] transition hover:bg-[#d3ddc5] hover:-translate-y-0.5"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <path d="M5.2 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3.5 9h3.4v11.5H3.5V9Zm5.5 0h3.3v1.6h.1A3.6 3.6 0 0 1 15.7 8c3.5 0 4.2 2.3 4.2 5.2v7.3h-3.4V14c0-1.6 0-3.5-2.1-3.5s-2.4 1.7-2.4 3.4v6.6H9V9Z" />
              </svg>
            </a>

            <a
              href="https://wa.me/254728841558"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp"
              title="WhatsApp"
              class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#e2e6d7] text-[#176534] transition hover:bg-[#d3ddc5] hover:-translate-y-0.5"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z" />
                <path d="M9 8.5c.3-.6.6-.6.9-.6h.4c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .4-.1.6l-.5.6c-.2.2-.2.4 0 .6.4.7 1 1.3 1.7 1.7.2.1.4.1.6-.1l.7-.8c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5 0 .3-.2 1.1-.8 1.4-.5.3-1.1.4-1.8.2-1.1-.3-2.3-1-3.4-2.1-1-1-1.8-2.3-2-3.3-.2-.8 0-1.3.6-1.5Z" />
              </svg>
            </a>
          </div>
        </div>


        <div class="mt-6 space-y-3">
          {offices.slice(1).map((o) => (
            <div class="bg-white border border-[#0d3329]/10 p-6">
              <p class="text-[#0d3329] uppercase tracking-widest text-xs mb-2">{o.city}</p>
              <p class="text-[#3d3d3d] text-sm">{o.address}</p>
              <p class="text-[#3d3d3d] text-sm mt-1">{o.hours}</p>
              <a href={`tel:${o.phone.replace(/\s/g, "")}`} class="text-[#0d3329] text-sm font-semibold mt-2 inline-block">{o.phone}</a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#0d3329] relative">
    <div class="max-w-7xl mx-auto">
      <iframe
        src="https://www.google.com/maps?q=Moi+Avenue+Mombasa&output=embed"
        width="100%" height="420" style="border:0;" loading="lazy"
        referrerpolicy="no-referrer-when-downgrade" class="w-full"
        title="Olemonana House 1st Floor, Moi Avenue"
      ></iframe>
    </div>
  </section>

  <Footer />
</Base>