---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import KleapForm from "../components/KleapForm";

const base = import.meta.env.BASE_URL;

/* ───────────── 1. FEED SOURCES (edit freely) ─────────────
   Each entry is any RSS/Atom URL. Google News search feeds are used by default
   because they work for any query. To pull directly from a publisher, add its
   own RSS URL here, e.g. { name: "Publisher", url: "https://example.com/feed/" } */
const gnews = (q: string) =>
  `https://news.google.com/rss/search?q=${encodeURIComponent(q + " when:30d")}&hl=en-KE&gl=KE&ceid=KE:en`;

const FEEDS = [
  { url: gnews('"Mombasa tea auction" OR "Kenya tea auction" OR EATTA') },
  { url: gnews('KTDA OR "Tea Board of Kenya" OR "Kenyan tea"') },
  { url: gnews('"orthodox tea" OR "CTC tea" Kenya') },
  { url: gnews('tea exports Pakistan OR Egypt OR Kazakhstan OR "Middle East" Kenya') },
];

const MAX_ARTICLES = 7; // 1 featured + 6 in the grid

/* ───────────── 2. FALLBACK (your original articles) ─────────────
   Shown only if the live feeds fail or return too few items. */
const fallbackArticles = [
  {
    cat: "Market Update",
    date: "Tea Market Guide",
    title: "Understanding the Mombasa Tea Auction",
    excerpt: "Learn how tea lots are presented, evaluated and traded through the Mombasa auction system, and why current market conditions matter when planning purchases.",
    read: "Buyer guide",
    url: "",
    image: ""
  },
  {
    cat: "Origin",
    date: "Tea Origin Guide",
    title: "What Makes Kenyan Tea Distinctive?",
    excerpt: "Explore how growing conditions, tea varieties, harvesting practices and processing methods influence the characteristics of tea sourced from Kenya.",
    read: "Origin guide",
    url: "",
    image: ""
  },
  {
    cat: "Logistics",
    date: "Export Guide",
    title: "Preparing Kenyan Tea for Export",
    excerpt: "An introduction to export preparation, packaging requirements, shipment documentation and the coordination involved in delivering tea to international buyers.",
    read: "Export guide",
    url: "",
    image: ""
  },
  {
    cat: "Quality",
    date: "Tea Grade Guide",
    title: "Understanding Common Kenyan Tea Grades",
    excerpt: "Discover the differences between common CTC grades and selected Orthodox grades, and how product specifications help buyers identify suitable teas.",
    read: "Quality guide",
    url: "",
    image: ""
  },
  {
    cat: "Sustainability",
    date: "Industry Guide",
    title: "The Role of Smallholder Farmers in Kenyan Tea",
    excerpt: "Learn about the contribution of smallholder farmers to Kenya's tea industry and their role in the wider production and supply chain.",
    read: "Industry guide",
    url: "",
    image: ""
  },
  {
    cat: "Industry",
    date: "Buyer Guide",
    title: "Choosing Between CTC and Orthodox Tea",
    excerpt: "Compare the broad characteristics of CTC and Orthodox tea to help assess product requirements, intended use, grade preferences and customer specifications.",
    read: "Buyer guide",
    url: "",
    image: ""
  },
];

/* ───────────── 3. HELPERS ───────────── */
type Article = { cat: string; date: string; title: string; excerpt: string; read: string; url: string; image?: string; ts?: number };

const decode = (s: string) =>
  s.replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, "$1")
    .replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"').replace(/&#39;|&apos;/g, "'").replace(/&nbsp;/g, " ");
const stripHtml = (s: string) => decode(s).replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
const tag = (block: string, name: string) => {
  const m = block.match(new RegExp(`<${name}[^>]*>([\\s\\S]*?)</${name}>`, "i"));
  return m ? m[1] : "";
};
const clip = (s: string, n: number) => (s.length > n ? s.slice(0, n).replace(/\s+\S*$/, "") + "…" : s);

// Extract image URL from RSS item
const extractImage = (item: string): string => {
  // Try media:content first
  const mediaContent = item.match(/<media:content[^>]*url="([^"]+)"/i)?.[1];
  if (mediaContent) return mediaContent;
  
  // Try media:thumbnail
  const mediaThumbnail = item.match(/<media:thumbnail[^>]*url="([^"]+)"/i)?.[1];
  if (mediaThumbnail) return mediaThumbnail;
  
  // Try enclosure
  const enclosure = item.match(/<enclosure[^>]*url="([^"]+)"/i)?.[1];
  if (enclosure && /\.(jpg|jpeg|png|gif|webp)$/i.test(enclosure)) return enclosure;
  
  // Try img tag in description
  const imgInDesc = item.match(/<description[^>]*>([\s\S]*?)<\/description>/i)?.[1]
    .match(/<img[^>]*src="([^"]+)"/i)?.[1];
  if (imgInDesc) return imgInDesc;
  
  // Try Google News image from content
  const contentImg = item.match(/<img[^>]*src="([^"]+)"/i)?.[1];
  if (contentImg) return contentImg;
  
  return "";
};

// Map headlines onto the category names your design already uses
const CATEGORY_RULES: [RegExp, string][] = [
  [/auction|price|prices|earn|sh\d|\$\d|market/i, "Market Update"],
  [/orthodox|ctc|grade|quality|lab(oratory)?|standards?/i, "Quality"],
  [/ship|port|freight|logistic|container|vessel|export/i, "Logistics"],
  [/smallholder|farmer|climate|sustainab|ktda|rain|drought|el ni[nñ]o/i, "Sustainability"],
  [/estate|region|kericho|nandi|origin|harvest|production/i, "Origin"],
];
const categorise = (t: string) => CATEGORY_RULES.find(([re]) => re.test(t))?.[1] ?? "Industry";

// Keep only genuine tea-trade stories
const isRelevant = (t: string) =>
  /\btea\b|\bKTDA\b|\bEATTA\b|Mombasa Tea Auction|Tea Board of Kenya/i.test(t) &&
  !/spill the tea|tea party|bubble tea|milk tea|tea shop|tea room/i.test(t);

async function loadFeed(url: string): Promise<Article[]> {
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 8000);
  try {
    const res = await fetch(url, { signal: ctrl.signal, headers: { "User-Agent": "Mozilla/5.0 (compatible; DrincoSite/1.0)" } });
    if (!res.ok) return [];
    const xml = await res.text();
    const items = xml.match(/<item[\s\S]*?<\/item>/gi) ?? xml.match(/<entry[\s\S]*?<\/entry>/gi) ?? [];
    return items.map((it): Article | null => {
      let title = stripHtml(tag(it, "title"));
      const link = stripHtml(tag(it, "link")) || (it.match(/<link[^>]*href="([^"]+)"/i)?.[1] ?? "");
      const pub = tag(it, "pubDate") || tag(it, "published") || tag(it, "updated");
      let source = stripHtml(tag(it, "source"));
      // Google News titles look like "Headline - Publisher"
      const split = title.lastIndexOf(" - ");
      if (split > 20) {
        if (!source) source = title.slice(split + 3);
        title = title.slice(0, split);
      }
      const ts = Date.parse(pub);
      if (!title || !link || Number.isNaN(ts) || !isRelevant(title)) return null;
      let excerpt = clip(stripHtml(tag(it, "description") || tag(it, "summary")), 190);
      // Google News descriptions only repeat the headline, so don't show that as an excerpt
      if (excerpt.toLowerCase().startsWith(title.toLowerCase().slice(0, 30)) || excerpt.length < 40) excerpt = "";
      const image = extractImage(it);
      return {
        cat: categorise(title),
        date: new Date(ts).toLocaleDateString("en-GB", { month: "long", year: "numeric" }),
        title,
        excerpt: excerpt || `Read the full story${source ? ` at ${source}` : ""}.`,
        read: source || "Tea industry news",
        url: link,
        image: image || undefined,
        ts,
      };
    }).filter((a): a is Article => a !== null);
  } catch {
    return []; // a failing feed must never break the build
  } finally {
    clearTimeout(timer);
  }
}

/* ───────────── 4. BUILD THE LIST ───────────── */
const results = (await Promise.all(FEEDS.map((f) => loadFeed(f.url)))).flat();

// de-duplicate near-identical headlines, newest first
const seen = new Set<string>();
const live = results
  .sort((a, b) => (b.ts ?? 0) - (a.ts ?? 0))
  .filter((a) => {
    const key = a.title.toLowerCase().replace(/[^a-z0-9]/g, "").slice(0, 60);
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  })
  .slice(0, MAX_ARTICLES);

const articles: Article[] = live.length >= 3 ? live : fallbackArticles;
const isLive = live.length >= 3;
const featured = articles[0];
const rest = articles.slice(1);

const tags = ["Auction", "CTC", "Orthodox", "Origin", "Sustainability", "Logistics", "Quality", "Central Asia", "Middle East"];
---
<Base
  title="Kenyan Tea Market News & Insights | Drinco International"
  description="Follow Kenyan tea market news, Mombasa auction updates, CTC and Orthodox tea insights, export logistics and sourcing guidance from Drinco International."
>
  <Header />

 <section class="relative bg-[#0d3329] text-[#f4ecdc] py-24 md:py-32 overflow-hidden">
  <img
  src={`${base}images/hero-insights.webp`}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover"
    onerror="this.style.display='none'"
  />
  <div class="absolute inset-0 bg-gradient-to-br from-[#0d3329]/90 via-[#0d3329]/70 to-[#0d3329]/40"></div>
  <div class="relative max-w-5xl mx-auto px-5 lg:px-8">
    <p class="text-[#b9a48a] uppercase tracking-[0.3em] text-xs mb-6">News & Insights</p>
    <h1 class="text-5xl md:text-7xl leading-[0.95]" style="font-family:'DM Serif Display',serif;font-weight:400;">
      Notes from<br/><span class="text-[#b9a48a]">the auction floor.</span>
    </h1>
    <p class="mt-8 text-lg text-[#f4ecdc]/85 max-w-2xl leading-relaxed">
      Tea industry news, Mombasa auction coverage, origin insights and export guidance for buyers sourcing tea from Kenya and beyond.
    </p>
  </div>
</section>

  <section class="bg-[#f4ecdc] py-12 border-b border-[#0d3329]/10">
    <div class="max-w-7xl mx-auto px-5 lg:px-8 flex flex-wrap items-center gap-3">
      <span class="text-[#0d3329] text-xs uppercase tracking-widest mr-2">Topics</span>
      {tags.map((t) => (
        <span class="px-3 py-1.5 bg-white border border-[#0d3329]/15 text-[#0d3329] text-xs uppercase tracking-widest">{t}</span>
      ))}
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <article class="grid lg:grid-cols-2 gap-12 pb-16 mb-16 border-b border-[#0d3329]/15">
        <div>
          <p class="text-[#b9a48a] text-xs uppercase tracking-widest mb-4">Featured · {featured.cat}</p>
          <h2 class="text-3xl md:text-5xl text-[#0d3329] leading-tight mb-5" style="font-family:'DM Serif Display',serif;font-weight:400;">
            {featured.url ? (
              <a href={featured.url} target="_blank" rel="noopener noreferrer" class="hover:text-[#b9a48a] transition-colors">{featured.title}</a>
            ) : featured.title}
          </h2>
          <p class="text-[#3d3d3d] leading-relaxed">{featured.excerpt}</p>
          <p class="mt-6 text-sm text-[#3d3d3d] uppercase tracking-widest">{featured.date} · {featured.read}</p>
          {featured.url && (
            <a href={featured.url} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 text-[#0d3329] text-sm font-semibold hover:text-[#b9a48a] transition-colors">
              Read full story →
            </a>
          )}
        </div>
        
        <div class="bg-[#0d3329] aspect-[4/3] relative overflow-hidden">
          <img
            src={featured.image || `${base}images/tea-market.webp`}
            alt={featured.title}
            class="featured-market-image absolute inset-0 w-full h-full object-cover"
            loading="eager"
            onerror={`if (!this.dataset.fallback) {
              this.dataset.fallback = "true";
              this.src = "${base}images/tea-plantation-highlands.webp";
            } else {
              this.style.display = "none";
              this.nextElementSibling.style.display = "flex";
            }`}
          />

          <div
            class="absolute inset-0 hidden flex-col items-center justify-center gap-3 p-8 text-center"
            aria-hidden="true"
          >
            <span
              class="text-[#b9a48a] text-7xl"
              style="font-family:'DM Serif Display',serif;"
            >
              Drinco
            </span>
            <span class="text-[#f4ecdc]/80 text-xs uppercase tracking-[0.25em]">
              Tea Market Insights
            </span>
          </div>

          <div class="absolute inset-0 bg-gradient-to-t from-[#0d3329]/35 to-transparent pointer-events-none"></div>
        </div>

      </article>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-[#0d3329]/10 border border-[#0d3329]/10">
        {rest.map((a) => (
          <article class="relative bg-white p-7 group hover:bg-[#0d3329] transition-colors">
            <p class="text-[#b9a48a] text-xs uppercase tracking-widest mb-3 group-hover:text-[#d4b896]">{a.cat} · {a.date}</p>
            <h3 class="text-[#0d3329] group-hover:text-[#f4ecdc] text-xl mb-3 leading-tight" style="font-family:'DM Serif Display',serif;font-weight:400;">
              {a.url ? (
                <a href={a.url} target="_blank" rel="noopener noreferrer" class="after:content-[''] after:absolute after:inset-0">{a.title}</a>
              ) : a.title}
            </h3>
            <p class="text-[#3d3d3d] group-hover:text-[#f4ecdc]/80 text-sm leading-relaxed mb-5">{a.excerpt}</p>
            <p class="text-xs text-[#3d3d3d] group-hover:text-[#f4ecdc]/70 uppercase tracking-widest">{a.read}</p>
          </article>
        ))}
      </div>

      {isLive && (
        <p class="mt-8 text-xs text-[#3d3d3d]/70">
          Headlines are gathered automatically from third-party publishers and link to the original stories. All rights remain with the respective publishers.
        </p>
      )}
    </div>
  </section>

  {/*<section class="bg-[#0d3329] text-[#f4ecdc] py-20 text-center">
    <div class="max-w-3xl mx-auto px-5">
      <h2 class="text-3xl md:text-4xl leading-tight" style="font-family:'DM Serif Display',serif;font-weight:400;">
        Get the next one by email
      </h2>
      <p class="mt-5 text-[#f4ecdc]/80">
        A short monthly note from the Mombasa floor — auction prices, shipping alerts and the one origin story we think is worth your time.
      </p>
      <div class="mt-10 max-w-md mx-auto">
        <KleapForm
          client:load
          formId="newsletter"
          title="Subscribe"
          fields={[{ name: "email", label: "Email", type: "email", required: true }]}
          submitText="Subscribe"
          theme="dark"
        />
      </div>
    </div>
  </section>*/}

  <section class="bg-[#0d3329] text-[#f4ecdc] py-20 text-center">
  <div class="max-w-3xl mx-auto px-5">
    <p class="text-[#b9a48a] uppercase tracking-[0.3em] text-xs mb-4">Work With Us</p>
    <h2 class="text-3xl md:text-4xl leading-tight" style="font-family:'DM Serif Display',serif;font-weight:400;">
      Looking to source Kenyan tea?
    </h2>
    <p class="mt-5 text-[#f4ecdc]/80">
      Share your preferred tea grade, quantity, packaging and destination. We will review your requirements and discuss available options, specifications and export arrangements.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href={`${base}contact/`} class="inline-flex items-center gap-2 px-7 py-4 bg-[#b9a48a] text-[#0d3329] font-semibold hover:bg-[#d4b896] transition-colors">
        Request a Quote
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href={`${base}our-tea/`} class="inline-flex items-center gap-2 px-7 py-4 border border-[#f4ecdc]/40 text-[#f4ecdc] hover:bg-[#f4ecdc]/10 transition-colors">
        Explore Our Teas
      </a>
    </div>
  </div>
</section>

  <Footer />
</Base>