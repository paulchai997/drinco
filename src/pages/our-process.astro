---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const base = import.meta.env.BASE_URL;

const steps = [
  {
    n: "01",
    title: "Tea Auction",
    desc: "We assess available tea lots at the Mombasa Tea Auction and coordinate purchasing according to customer orders, grade requirements and prevailing market conditions.",
    detail: "Mombasa Tea Auction",
  },
  {
    n: "02",
    title: "Sourcing",
    desc: "For buyers seeking particular origins or supply arrangements, we work to identify suitable tea, review available samples and coordinate sourcing according to the required specifications.",
    detail: "Grade and origin requirements",
  },
  {
    n: "03",
    title: "Quality Assessment",
    desc: "Tea is assessed against relevant quality requirements and customer specifications. Where applicable, sample evaluation and checks help determine whether a lot is suitable for the intended order.",
    detail: "Quality and specification checks",
  },
  {
    n: "04",
    title: "Order Preparation",
    desc: "We coordinate the preparation of tea according to the agreed grade, quantity, packaging and customer requirements. Any special processing or product preparation is discussed and confirmed before fulfilment.",
    detail: "Order-specific preparation",
  },
  {
    n: "05",
    title: "Export Documentation",
    desc: "We coordinate the export documents and applicable regulatory requirements for each shipment, working with the relevant authorities and service providers according to the product and destination.",
    detail: "Shipment documentation",
  },
  {
    n: "06",
    title: "Shipping Coordination",
    desc: "We coordinate shipment arrangements, cargo preparation and logistics with the relevant service providers. Available shipping options depend on the order, destination, carrier and agreed delivery requirements.",
    detail: "Export and freight coordination",
  },
  {
    n: "07",
    title: "Destination & Delivery",
    desc: "We keep customers informed about shipment progress and coordinate documentation and delivery arrangements according to the agreed order and destination requirements.",
    detail: "Worldwide customer coordination",
  },
];
---
<Base
  title="Our Tea Export Process | Drinco International"
  description="Discover how Drinco International coordinates Kenyan tea sourcing, auction purchasing, quality checks, export documentation and shipping for international buyers."
>
  <Header />

  <section class="relative bg-[#0d3329] text-[#f4ecdc] py-24 md:py-32 overflow-hidden">
  <img
  src={`${base}images/hero-process.webp`}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover"
    onerror="this.style.display='none'"
  />
  <div class="absolute inset-0 bg-gradient-to-br from-[#0d3329]/90 via-[#0d3329]/70 to-[#0d3329]/40"></div>
  <div class="relative max-w-5xl mx-auto px-5 lg:px-8">
    <p class="text-[#b9a48a] uppercase tracking-[0.3em] text-xs mb-6">Our Process</p>
    <h1 class="text-5xl md:text-7xl leading-[0.95]" style="font-family:'DM Serif Display',serif;font-weight:400;">
      From Kenyan Tea<br/>
      <span class="text-[#b9a48a]">Sourcing to Export.</span>
    </h1>
    <p class="mt-8 text-lg text-[#f4ecdc]/85 max-w-3xl leading-relaxed">
      Discover how we coordinate tea purchasing, sourcing, quality assessment, order preparation, export documentation and shipping. Each order is handled according to the agreed specifications, applicable requirements and destination arrangements.
    </p>
  </div>
</section>

  <section class="bg-[#f4ecdc] py-12">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="grid grid-cols-4 md:grid-cols-7">
        {steps.map((s, i) => (
          <div class={`p-4 text-[#0d3329] text-xs uppercase tracking-widest text-center ${i < steps.length - 1 ? "border-r border-[#0d3329]/20" : ""}`}>
            {s.n}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white">
    {steps.map((s, i) => (
      <div class={`${i % 2 === 0 ? "bg-white" : "bg-[#f4ecdc]"} py-20`}>
        <div class="max-w-7xl mx-auto px-5 lg:px-8 grid lg:grid-cols-12 gap-10">
          <div class="lg:col-span-2">
            <p class="text-[#b9a48a] text-6xl" style="font-family:'DM Serif Display',serif;">{s.n}</p>
          </div>
          <div class="lg:col-span-7">
            <h2 class="text-3xl md:text-4xl text-[#0d3329] leading-tight mb-5" style="font-family:'DM Serif Display',serif;font-weight:400;">{s.title}</h2>
            <p class="text-[#3d3d3d] leading-relaxed text-lg">{s.desc}</p>
          </div>
          <div class="lg:col-span-3 lg:border-l lg:border-[#0d3329]/15 lg:pl-8 flex items-center">
            <p class="text-[#0d3329] text-sm uppercase tracking-widest">{s.detail}</p>
          </div>
        </div>
      </div>
    ))}
  </section>

  <section class="bg-[#0d3329] text-[#f4ecdc] py-24 text-center">
    <div class="max-w-3xl mx-auto px-5">
      <h2 class="text-4xl md:text-5xl leading-tight" style="font-family:'DM Serif Display',serif;font-weight:400;">
        Ready to order?
      </h2>
      <p class="mt-5 text-[#f4ecdc]/85">
         Share your preferred tea grade, quantity, packaging and destination. We will review your requirements and discuss availability, documentation, shipping arrangements and a suitable quotation.
      </p>
      <a href={`${base}contact`} class="mt-8 inline-flex items-center gap-2 px-7 py-4 bg-[#b9a48a] text-[#0d3329] font-semibold hover:bg-[#d4b896]">
        Start an Inquiry
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <Footer />
</Base>