
---
const whatsappNumber = "254716532887";
const message = "Hello Drinco International, I would like to enquire about your tea products and export services.";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
---

<div class="tea-chat" id="tea-chat">
  <section class="tea-chat__welcome" id="tea-chat-welcome" aria-label="Welcome message">
    <div class="tea-chat__header">
      <div class="tea-chat__brand-icon">
        <img src="/images/logo.png" alt="Drinco International logo" />
      </div>
      <div class="tea-chat__identity">
        <strong>Drinco International Limited</strong>
        <span><i></i> Tea enquiries</span>
      </div>
      <button class="tea-chat__close" id="tea-chat-close" type="button" aria-label="Close welcome message">×</button>
    </div>

    <p>Hi there! Need quality tea for your business? We're here to help with sourcing and export enquiries.</p>

    <a class="tea-chat__welcome-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
      Chat with us on WhatsApp
      <span aria-hidden="true">↗</span>
    </a>
    <span class="tea-chat__tail" aria-hidden="true"></span>
  </section>

  <a
    class="tea-chat__launcher"
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with Drinco International on WhatsApp"
    title="Chat with us on WhatsApp"
  >
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z"
        stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="tea-chat__online" aria-hidden="true"></span>
  </a>
</div>

<style>
  .tea-chat {
    --chat-green: #0d3329;
    --chat-accent: #7b963c;
    --chat-beige: #f4ecdc;
    position: fixed;
    right: max(22px, env(safe-area-inset-right));
    bottom: max(22px, env(safe-area-inset-bottom));
    z-index: 9999;
    font-family: "IBM Plex Sans", Arial, sans-serif;
  }

  .tea-chat__welcome {
    position: absolute;
    right: 0;
    bottom: 96px;
    width: min(300px, calc(100vw - 40px));
    padding: 17px 16px 16px;
    color: #26342e;
    background: #fff;
    border: 1px solid rgba(13, 51, 41, 0.08);
    border-radius: 18px;
    box-shadow: 0 12px 32px rgba(21, 42, 31, 0.16);
    animation: tea-chat-enter 0.45s ease-out both;
  }

  .tea-chat__welcome[hidden] {
    display: none;
  }

  .tea-chat__header {
    display: flex;
    align-items: center;
    gap: 9px;
    padding-right: 18px;
  }

  .tea-chat__brand-icon {
  display: grid;
  flex: 0 0 36px;
  width: 36px;
  height: 36px;
  place-items: center;
  overflow: hidden;
  background: #f4ecdc;
  border-radius: 50%;
}

.tea-chat__brand-icon img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

  .tea-chat__identity {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .tea-chat__identity strong {
    color: var(--chat-green);
    font-size: 13px;
    line-height: 1.3;
  }

  .tea-chat__identity span {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #66736b;
    font-size: 11px;
  }

  .tea-chat__identity i,
  .tea-chat__online {
    display: block;
    width: 7px;
    height: 7px;
    background: #22c55e;
    border-radius: 50%;
  }

  .tea-chat__close {
    position: absolute;
    top: -10px;
    right: -10px;
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    color: #fff;
    background: #9ca3af;
    border: 2px solid #fff;
    border-radius: 50%;
    cursor: pointer;
    font-size: 21px;
    line-height: 1;
  }

  .tea-chat__welcome p {
    margin: 12px 0 14px;
    color: #435047;
    font-size: 13px;
    line-height: 1.6;
  }

  .tea-chat__welcome-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 11px 12px;
    color: var(--chat-green);
    background: #edf3e8;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }

  .tea-chat__welcome-link:hover {
    background: #e1ecd8;
  }

  .tea-chat__tail {
    position: absolute;
    right: 24px;
    bottom: -7px;
    width: 14px;
    height: 14px;
    background: #fff;
    border-right: 1px solid rgba(13, 51, 41, 0.08);
    border-bottom: 1px solid rgba(13, 51, 41, 0.08);
    transform: rotate(45deg);
  }

  .tea-chat__launcher {
    position: relative;
    display: grid;
    width: 64px;
    height: 64px;
    margin-left: auto;
    place-items: center;
    color: #fff;
    background: linear-gradient(140deg, #0d6b3b 10%, #246c38 52%, #8b9b38 100%);
    border: 0;
    border-radius: 50%;
    box-shadow: 0 0 0 10px rgba(73, 126, 76, 0.12),
                0 8px 24px rgba(13, 51, 41, 0.2);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
  }

  .tea-chat__launcher:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 0 12px rgba(73, 126, 76, 0.13),
                0 10px 28px rgba(13, 51, 41, 0.25);
  }

  .tea-chat__launcher svg {
    width: 29px;
    height: 29px;
  }

  .tea-chat__online {
    position: absolute;
    top: -1px;
    right: -1px;
    width: 13px;
    height: 13px;
    border: 2px solid #fff;
  }

  @keyframes tea-chat-enter {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 480px) {
    .tea-chat {
      right: max(18px, env(safe-area-inset-right));
      bottom: max(20px, env(safe-area-inset-bottom));
    }

    .tea-chat__welcome {
      bottom: 88px;
      width: min(280px, calc(100vw - 36px));
    }

    .tea-chat__launcher {
      width: 58px;
      height: 58px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tea-chat__welcome {
      animation: none;
    }

    .tea-chat__launcher {
      transition: none;
    }
  }
</style>

<script>
  const closeButton = document.getElementById("tea-chat-close");
  const welcomeMessage = document.getElementById("tea-chat-welcome");

  closeButton?.addEventListener("click", () => {
    if (welcomeMessage) {
      welcomeMessage.hidden = true;
    }
  });
</script>
