---
const base = import.meta.env.BASE_URL;

const nav = [
  { href: `${base}`, label: "Home" },
  { href: `${base}/about`, label: "About" },
  { href: `${base}/our-tea`, label: "Our Tea" },
  { href: `${base}/global-markets`, label: "Global Markets" },
  { href: `${base}/our-process`, label: "Our Process" },
  { href: `${base}/sustainability`, label: "Sustainability" },
  { href: `${base}/insights`, label: "Insights" },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const normalizePath = (path: string) => path.replace(/\/$/, "") || "/";
---

<header class="fixed top-0 inset-x-0 z-50 backdrop-blur-md bg-[#0d3329]/85 border-b border-[#b9a48a]/20">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 h-20 flex items-center justify-between gap-8">

    <!-- Logo -->
    <a
      href={base}
      class="flex items-center gap-3 shrink-0 text-[#f4ecdc] hover:opacity-90"
    >
      <img
        src={`${base}/images/logo.png`}
        alt="Drinco International Limited logo"
        height="56"
        class="h-14 w-auto object-contain drop-shadow-[0_0_8px_rgba(244,236,220,0.35)]"
      />

      <span class="hidden sm:flex flex-col leading-tight whitespace-nowrap">
        <span
          class="text-base font-semibold tracking-wide"
          style="font-family:'DM Serif Display',serif;"
        >
          Drinco International
        </span>

        <span class="text-[10px] uppercase tracking-[0.2em] text-[#b9a48a]">
          Limited
        </span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-5 xl:gap-8 lg:ml-10">
      {nav.map((item) => {
        const isActive =
          normalizePath(current) === normalizePath(new URL(item.href, Astro.url).pathname);

        return (
          <a
            href={item.href}
            class={`text-sm tracking-wide ${
              isActive
                ? "text-[#b9a48a]"
                : "text-[#f4ecdc]/85 hover:text-[#b9a48a]"
            } transition-colors`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Contact Button -->
    <a
      href={`${base}/contact`}
      class="hidden lg:inline-flex items-center gap-2 px-5 py-2.5 bg-[#b9a48a] text-[#0d3329] text-sm font-semibold rounded-sm hover:bg-[#d4b896] transition-colors"
    >
      Get in Touch

      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>

    <!-- Mobile Menu Button -->
    <button
      class="lg:hidden text-[#f4ecdc] p-2"
      aria-label="Menu"
    >
      <svg
        width="26"
        height="26"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>

  </div>
</header>

<div class="h-20"></div>